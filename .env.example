# Meet Canlı Çeviri – yerel ayarlar
# Bu dosyayı ".env" adıyla kopyalayın, anahtarları yazın ve `npm run build` çalıştırın.
# .env dosyasını kimseyle paylaşmayın; dist/ klasörü de anahtarları içerir.

# Zorunlu
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# İsteğe bağlı (boş bırakılırsa varsayılan kullanılır)
# claude-haiku-5-5 (onerilen: en hizli) | claude-opus-5-5 (en kaliteli; FAST_MODE ile hizli, pahali) | claude-sonnet-5-5 | claude-fable-5-2
CLAUDE_MODEL=claude-haiku-5-5
# Yalnızca Opus/Fable seçilirse: daha düşük gecikme (Claude ücreti ~2x): true | false
FAST_MODE=true
# Karşı taraf konuşurken anlık İngilizce taslak altyazı (Haiku 5.5): true | false
LIVE_DRAFTS=true
# eleven_v4_turbo | eleven_flash_v2_5 | eleven_v3
TTS_MODEL=eleven_v4_turbo
# Kendi ses klonunuzun kimliği (boşsa hazır bir ses kullanılır)
VOICE_ID=
# formal (siz) | informal (sen)
FORMALITY=formal
# Dilbilgisi cinsiyetiniz (bazı dillerde "ben" cümleleri için): male | female | boş
SPEAKER_GENDER=
# Korunacak isim ve terimler, virgülle ayrılmış
GLOSSARY=
# Orijinal sesiniz çevirinin altında: off | low
ORIGINAL_VOICE=off
# Yankı koruması (hoparlörle konuşurken açık kalsın; kulaklık kullanıyorsanız false yapabilirsiniz): true | false
ECHO_GUARD=true
# Karşı tarafın sesi: tab (önerilen, Chrome sekme sesi) | page (deneysel, Meet bağlantısı)
INCOMING_SOURCE=tab
# Altyazı boyutu: s | m | l
CAPTION_SIZE=m
SHOW_LATENCY=true
